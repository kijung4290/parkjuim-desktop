{
  "name": "parkjuim-desktop",
  "version": "1.4.0",
  "description": "바탕화면을 산책하는 3D 박주임 · Claude·Gemini·GPT AI 컴패니언",
  "author": "박주임",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kijung4290/parkjuim-desktop.git"
  },
  "homepage": "https://github.com/kijung4290/parkjuim-desktop#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "predist": "node scripts/prepare-electron.cjs",
    "dist": "node scripts/build.cjs",
    "pack": "electron-builder --dir --win --x64",
    "smoke": "electron . --smoke-test",
    "verify:feed": "electron scripts/verify-update-feed.cjs",
    "verify:startup": "electron scripts/verify-startup.cjs",
    "verify:voice": "node scripts/verify-elevenlabs.cjs",
    "smoke:voice": "electron . --voice-smoke-test",
    "verify:chat": "electron scripts/verify-claude.cjs",
    "verify:research": "electron scripts/verify-research.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@elevenlabs/elevenlabs-js": "2.74.0",
    "@google/genai": "2.31.0",
    "dotenv": "18.0.9",
    "electron-updater": "6.8.11",
    "htmlparser2": "12.0.0",
    "mammoth": "1.13.0",
    "openai": "7.45.0",
    "three": "0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jszip": "3.10.2"
  },
  "build": {
    "appId": "kr.parkjuim.desktop",
    "productName": "박주임 미니미",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "kijung4290",
        "repo": "parkjuim-desktop",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "박주임 미니미",
      "installerLanguages": [
        "ko_KR"
      ],
      "artifactName": "Parkjuim-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Parkjuim-Portable-${version}.${ext}"
    }
  }
}
